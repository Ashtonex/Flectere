# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — full database access, bypasses RLS. Server-side only.
# Used for admin actions like creating client logins. NEVER prefix this
# with NEXT_PUBLIC_, and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
